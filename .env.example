# ─── Database (Supabase or Neon PostgreSQL) ─────────────────────────────────
# Pooled connection used by the app at runtime (serverless-safe).
#   Supabase: Project → Connect → "Transaction pooler" (port 6543)
#   Neon:     connection string with "-pooler" in the host
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
# Used by Prisma migrations and the seed.
#   Supabase: Project → Connect → "Session pooler" (port 5432). Not the "Direct connection":
#             that host is IPv6-only and Vercel build machines can't reach it.
#   Neon:     connection string WITHOUT "-pooler"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Optional, recommended: Supabase CA certificate (Database settings → SSL → Download), pasted as
# either as-is (multi-line) or as one line with \n for line breaks. With it, connections are
# verified, not just encrypted.
DATABASE_CA_CERT=""
# Max connections per serverless instance (keep small on Vercel).
DB_POOL_MAX=5

# ─── Sessions ────────────────────────────────────────────────────────────────
# Random string, at least 32 chars. Generate with:  openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=""

# ─── Supabase Storage (asset images, invoices, handover docs) ────────────────
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# Server-only secret. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="eams-documents"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL encoded in asset QR codes. Defaults to the request's host if unset;
# set it on Vercel so labels printed from a preview URL still point at production.
APP_URL="https://assets.yourcompany.com"
# Printed at the top of asset labels.
COMPANY_NAME="Your Company Pvt Ltd"

# ─── Seed (npx prisma db seed) ───────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@company.com"
SEED_ADMIN_NAME="System Administrator"
# Required the first time the seed runs. Min 10 chars.
SEED_ADMIN_PASSWORD=""
# "true" adds demo departments, employees, assets, etc. Use only in development.
SEED_DEMO_DATA="false"
SEED_DEMO_PASSWORD="Demo@12345"

# ─── Scheduled reminders (Vercel Cron → /api/cron/daily) ────────────────────
# Random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# ─── Device passwords ────────────────────────────────────────────────────────
# Encrypts saved laptop/BIOS passwords (AES-256-GCM). Generate: openssl rand -base64 32
# Keep a copy somewhere safe (e.g. your password manager): if it's lost or changed,
# saved passwords can no longer be decrypted. Leave empty to turn the feature off.
CREDENTIALS_ENCRYPTION_KEY=""
